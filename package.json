{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-sleep-inhibit",
  "version": "0.1.0",
  "description": "Prevent Linux sleep while OpenCode agents are working.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && bun test",
    "prepack": "bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "linux",
    "systemd",
    "sleep-inhibit",
    "suspend",
    "hibernate",
    "keep-awake",
    "wakelock",
    "ai-agent"
  ],
  "homepage": "https://github.com/seaweeduk/opencode-sleep-inhibit#readme",
  "bugs": "https://github.com/seaweeduk/opencode-sleep-inhibit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seaweeduk/opencode-sleep-inhibit.git"
  },
  "author": "seaweeduk",
  "license": "MIT",
  "os": [
    "linux"
  ],
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.5",
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}
